{
  "name": "nest-native-drizzle-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Community standalone monorepo for @nest-native/drizzle and samples",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "sample/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "TS_NODE_PROJECT=tsconfig.spec.json node --require ts-node/register --require reflect-metadata --test packages/drizzle/test/*.spec.ts",
    "test:report": "node scripts/run-node-test-report.cjs",
    "test:cov": "c8 --all --include \"packages/drizzle/**/*.ts\" --exclude \"packages/drizzle/test/**\" --exclude \"packages/drizzle/interfaces.ts\" --exclude \"packages/drizzle/index.ts\" --exclude \"**/*.d.ts\" --exclude \"**/dist/**\" --reporter text --reporter text-summary --reporter json-summary --reporter lcov --check-coverage --branches 100 --functions 100 --lines 100 --statements 100 npm run test:report",
    "test:watch": "TS_NODE_PROJECT=tsconfig.spec.json node --watch --require ts-node/register --require reflect-metadata --test packages/drizzle/test/*.spec.ts",
    "complexity:check": "eslint --config eslint.complexity-check.config.mjs \"packages/drizzle/**/*.ts\"",
    "complexity:report": "node scripts/collect-cognitive-complexity.mjs",
    "release:check:readme-links": "node scripts/check-readme-links.mjs",
    "release:check:sample-versions": "node scripts/check-sample-version-sync.mjs",
    "release:check:pack": "npm run build --workspace @nest-native/drizzle && node scripts/check-package-pack.mjs",
    "release:check:consumer": "node scripts/check-packed-consumer.mjs",
    "release:check:published": "node scripts/check-published-release.mjs",
    "release:check": "npm run release:check:readme-links && npm run release:check:sample-versions && npm run release:check:pack && npm run release:check:consumer",
    "ci:docs": "npm --prefix website ci && npm --prefix website run build",
    "security:audit:package": "node scripts/audit-production-surface.mjs",
    "security:audit:docs": "npm --prefix website audit --audit-level=high",
    "security:audit": "npm run security:audit:package && npm run security:audit:docs:soft",
    "showcase": "node scripts/run-optional-workspace.cjs nest-native-drizzle-showcase test",
    "sample:focused": "node scripts/run-focused-samples.mjs",
    "sample": "npm run showcase && npm run sample:focused",
    "ci:sample": "npm run sample",
    "ci": "npm run typecheck && npm run test:cov && npm run complexity:check && npm run complexity:report && npm run release:check && npm run ci:docs && npm run security:audit && npm run ci:sample",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "test:full": "NEST_DRIZZLE_NATIVE_POSTGRES_URL=postgres://drizzle:drizzle@127.0.0.1:54321/drizzle NEST_DRIZZLE_NATIVE_MYSQL_URL=mysql://drizzle:drizzle@127.0.0.1:33061/drizzle npm run test",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "test:mutant": "TS_NODE_PROJECT=tsconfig.spec.json node --require ts-node/register --require reflect-metadata --test --test-force-exit packages/drizzle/test/*.spec.ts",
    "test:mutant:full": "NEST_DRIZZLE_NATIVE_POSTGRES_URL=postgres://drizzle:drizzle@127.0.0.1:54321/drizzle NEST_DRIZZLE_NATIVE_MYSQL_URL=mysql://drizzle:drizzle@127.0.0.1:33061/drizzle npm run test:mutant",
    "security:audit:docs:soft": "npm run security:audit:docs || node -e \"console.log('\\\\n[non-blocking] Docs-site advisories reported above. They live in the website/ tree, which is never published to consumers, so per the guidelines they do not gate releases \u2014 Dependabot tracks them.')\""
  },
  "engines": {
    "node": ">=20"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@nestjs-cls/transactional": "^3.2.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^1.4.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "better-sqlite3": "^12.11.1",
    "c8": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "mysql2": "^3.23.4",
    "nestjs-cls": "^6.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "multer": "^2.2.0"
  },
  "packageManager": "npm@11.13.0"
}
