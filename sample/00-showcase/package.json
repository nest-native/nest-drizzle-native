{
  "name": "nest-native-drizzle-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "Sample 00 - full Nest-native Drizzle showcase",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "ts-node --transpile-only scripts/smoke.ts",
    "test": "npm run typecheck && npm run smoke",
    "start": "ts-node --transpile-only src/main.ts",
    "start:fastify": "ts-node --transpile-only src/main.fastify.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nest-native/drizzle": "0.5.0",
    "@nestjs-cls/transactional": "^3.2.2",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^1.4.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "nestjs-cls": "^6.2.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
